{
  "name": "slothsort",
  "version": "0.1.0",
  "type": "module",
  "description": "SlothSort — Privacy-first Windows desktop AI file organizer (Hacktoberfest 2026)",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "start": "electron .",
    "test": "npm run test:validator && npm run test:scanner && npm run test:queue && npm run test:executor",
    "test:validator": "tsx src/testValidator.ts",
    "test:scanner": "tsx test/scanner.test.ts",
    "test:queue": "tsx test/queue.test.ts",
    "test:executor": "tsx test/executor.test.ts",
    "test:audit": "tsx test/releaseAudit.test.ts",
    "test:integration": "tsx test/queueIntegration.test.ts",
    "test:offline": "tsx src/testOffline.ts",
    "package": "npm run build && npx electron-builder --win --dir",
    "prototype": "tsx src/index.ts"
  },
  "build": {
    "appId": "com.slothsort.app",
    "productName": "SlothSort",
    "directories": {
      "output": "dist/package"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "keywords": [
    "file-organizer",
    "local-ai",
    "privacy-first",
    "ollama",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  }
}
